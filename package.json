{
  "name": "round-zero",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:types": "node scripts/generate-types.mjs",
    "check": "npm run check:source && npm run typecheck && npm run lint && npm test && npm run test:db && npm run build",
    "db:types:supabase": "node scripts/types-from-supabase.mjs",
    "local:env": "node scripts/local-env.mjs",
    "check:source": "node scripts/check-source.mjs",
    "prebuild": "npm run check:source"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tus-js-client": "4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
